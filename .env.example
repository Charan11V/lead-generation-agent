# Server OpenAI key (private — never shown in the UI).
OPENAI_API_KEY=sk-your-key
# Do NOT set a shared TAVILY_API_KEY for the web app.
# Each user adds their own Tavily key in Profile (encrypted per account).

# ── Production / Contabo ──
# FREQUENCY_DOMAIN=app.yourdomain.com   # optional — enables HTTPS via Caddy (primary VPS)
# CADDY_ACME_EMAIL=ops@frequency.cx
# White-label (Tovyq sidecar only — do not set on the Frequency server):
# APP_BRAND=Tovyq
# APP_BRAND_DOMAIN=tovyq.swameda.com
# APP_BRAND_URL=https://tovyq.swameda.com
FREQUENCY_DB_PATH=/app/var/frequency_agent.db
FREQUENCY_ADMIN_EMAILS=charan.s@frequency.cx
# Localhost-only extra admins (docker-compose.override.yml). Never enable on production:
# FREQUENCY_LOCAL_ADMINS=true
# FREQUENCY_LOCAL_ADMIN_EMAILS=saarthak@frequency.cx
# Generate strong random values for production (deploy script can append if missing):
# FREQUENCY_SECRETS_KEY=
# AUTH_SESSION_SECRET=

# Optional overrides
OPENAI_EXTRACT_MODEL=gpt-4o-mini
OPENAI_DRAFT_MODEL=gpt-4o
MAX_QUEUE=0
MAX_DISCOVER=40

# Optional free-tier news APIs for Signal desk (keyless sources still run)
# NEWSAPI_KEY=
# GNEWS_API_KEY=
# NEWSDATA_API_KEY=
# GUARDIAN_API_KEY=

# Parallelism (tune for your machine / API rate limits)
SEARCH_WORKERS=6
FETCH_WORKERS=10
LLM_WORKERS=4
ENRICH_WORKERS=5
CONTACT_WORKERS=4

# ── Auth ──
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# AUTH_PROVIDER=clerk
# AUTH_PROVIDER=local

RESEND_API_KEY=
RESET_EMAIL_FROM=Frequency <otp@auth.frequency.cx>
AUTH_DEV_MODE=0
